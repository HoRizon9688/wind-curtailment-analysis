* text=auto
*.py text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.ps1 text eol=crlf
*.html text eol=lf
# dashboard/protected-runtime.json hashes the worktree bytes of every protected
# file. Without an explicit LF checkout, a Windows worktree (core.autocrlf=true)
# gets CRLF and the full integrity check fails on every protected text file.
dashboard/** text=auto eol=lf
# Synthetic fixtures must stay byte-identical: the tests assert their SHA-256,
# and the CSV fixtures intentionally use CRLF while the GB18030 one is not UTF-8.
tests/fixtures/browser/spike/*.csv binary
tests/fixtures/browser/spike/*.xls binary
tests/fixtures/browser/spike/*.xlsx binary
tests/fixtures/browser/*.json.gz binary
tests/fixtures/browser/contract/inputs/*.csv binary
tests/fixtures/browser/contract/inputs/*.xls binary
tests/fixtures/browser/contract/inputs/*.xlsx binary
tests/fixtures/browser/contract/expected/*.json.gz binary
tests/fixtures/browser/reused-handoff/*.csv binary
# Public release assets must match the reviewed candidate byte-for-byte.
docs/index.html -text
docs/samples/*.csv binary
