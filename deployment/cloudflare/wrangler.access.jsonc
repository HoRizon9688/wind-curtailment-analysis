{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wind-curtailment-analysis",
  "main": "../access/worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "../../docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {"name": "ACCESS_LOGIN_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}
  ]
}
