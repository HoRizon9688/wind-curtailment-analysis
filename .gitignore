# Keep nested publication history local; track dashboard source explicitly.
/dashboard/.git/
# Ignore hosted identity and credentials, but track the identity-free baseline
# file the protected-runtime manifest requires, so a fresh clone can verify.
/dashboard/.openai/*
!/dashboard/.openai/hosting.json
/dashboard/src/data.json
/dashboard/dist/
/dashboard/.data-app-assets/
/dashboard/.data-app-offline/

